<Window x:Class="DcxMail.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DarkCipher MaskedMail — by darkcipher0x" Height="860" Width="1380" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico" FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource FsBase}"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" SourceInitialized="OnSourceInitialized" Closing="OnClosing">
    <Window.Resources>
        <!-- Masked address row: title, address, provider chip, state and folder markers -->
        <DataTemplate x:Key="AliasRow">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,6,0,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Good}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter Property="Fill" Value="{DynamicResource Bad}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Email}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FsMeta}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="6,1,0,0" HorizontalAlignment="Right">
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="2" Padding="4,0">
                        <TextBlock Text="{Binding ProviderName}" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource Accent}"/>
                    </Border>
                    <TextBlock Text="📁 routed" FontSize="{DynamicResource FsMicro}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Routed}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Throwaway address: time left -->
                    <TextBlock Text="{Binding ExpiryText}" FontSize="{DynamicResource FsMicro}" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" HorizontalAlignment="Right" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExpiryText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MessageRow">
            <Grid Margin="2,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding FromText}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Unread}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding DateText}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FsCaption}" Foreground="{DynamicResource Muted}" Margin="8,0,0,0"/>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource FsBody}"/>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource FsMeta}" Foreground="{DynamicResource Muted}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Header (same layout as DarkCipher ServerManagement) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBg}" Padding="14,8" BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,1">
            <DockPanel>
                <ComboBox DockPanel.Dock="Right" x:Name="ThemeBox" Width="110" Margin="8,0,0,0" VerticalAlignment="Center" SelectionChanged="OnThemeChanged" ToolTip="Colour theme">
                    <ComboBoxItem Content="◐  System" Tag="System"/>
                    <ComboBoxItem Content="☾  Dark" Tag="Dark"/>
                    <ComboBoxItem Content="☀  Light" Tag="Light"/>
                </ComboBox>
                <Button DockPanel.Dock="Right" Content="⚙  Settings" Click="OnSettings" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="API keys, routing and behaviour"/>
                <Button DockPanel.Dock="Right" x:Name="LockBtn" Content="🔒" MinWidth="0" Padding="9,5" Click="OnLock" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Lock now (Ctrl+Shift+L)"/>
                <Button DockPanel.Dock="Right" x:Name="AddonsBtn" Content="◇  Add-ons ▾" Click="OnAddonsMenu" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Run an add-on command, or manage add-ons"/>
                <Button DockPanel.Dock="Right" x:Name="QueueBtn" Content="📤  Queue" Click="OnQueueWindow" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Outgoing queue: emails waiting to be sent together (Ctrl+Shift+Q)"/>
                <Button DockPanel.Dock="Right" Content="✉  New email" Click="OnCompose" VerticalAlignment="Center" ToolTip="Write an email (Ctrl+N)"/>
                <Button DockPanel.Dock="Right" x:Name="ThrowawayBtn" Content="⏱  Throwaway ▾" Click="OnThrowawayMenu" VerticalAlignment="Center" ToolTip="A disposable address that deletes itself after a set time, with a live inbox for codes and links (Ctrl+Shift+T = default lifetime)"/>
                <Button DockPanel.Dock="Right" Content="＋  New masked email" Style="{StaticResource PrimaryButton}" Click="OnNewAlias" VerticalAlignment="Center" ToolTip="Create a masked address (Ctrl+Shift+N)"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Margin="0,0,12,0" VerticalAlignment="Center" CornerRadius="20">
                        <Image Source="Assets/logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DarkCipher MaskedMail" Foreground="{DynamicResource HeaderFg}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FsH1}" FontWeight="Bold"/>
                            <TextBlock x:Name="VersionText" Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FsCaption}" Margin="10,0,0,2" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock Text="darkcipher0x@masked:~$" Foreground="{DynamicResource Brand}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FsSmall}"/>
                            <Border Width="7" Height="13" Margin="5,0,0,0" Background="{DynamicResource Brand}" VerticalAlignment="Center">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1.1">
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="0"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,3">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="⟳ sweep now" Style="{StaticResource SmallButton}" Click="OnSweep" ToolTip="File Inbox mail for routed addresses into their folders now"/>
                <Button DockPanel.Dock="Right" x:Name="SecurityBadge" Style="{StaticResource SmallButton}" Margin="0,0,10,0" Click="OnSecurityBadge" ToolTip="Security &amp; privacy settings: master password, 2FA, app lock, backups"/>
                <TextBlock DockPanel.Dock="Right" x:Name="RouteText" Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FsCaption}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FsCaption}" Text="ready" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="380" MinWidth="260"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left: mailboxes + masked addresses -->
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="MAILBOXES" Style="{StaticResource NavHeader}" Cursor="Arrow"/>
                        <RadioButton x:Name="NavInbox" Style="{StaticResource NavItem}" Content="📥  Inbox" Checked="OnNavInbox"/>
                        <RadioButton x:Name="NavSent" Style="{StaticResource NavItem}" Content="📤  Sent" Checked="OnNavSent"/>
                        <DockPanel Margin="14,14,10,4">
                            <Button DockPanel.Dock="Right" Content="⟳" Style="{StaticResource SmallButton}" Margin="0" Click="OnRefresh" ToolTip="Reload masked addresses from every service (F5)"/>
                            <TextBlock Text="MASKED ADDRESSES" Style="{StaticResource NavHeader}" Margin="0" Cursor="Arrow" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="10,2,10,6">
                            <TextBlock x:Name="SearchHint" Text="search addresses, notes, sites" Foreground="{DynamicResource Muted}" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="{DynamicResource FsMeta}"/>
                            <TextBox x:Name="SearchBox" Padding="5,4" Background="Transparent" TextChanged="OnSearch"/>
                        </Grid>
                        <DockPanel Margin="10,0,10,6">
                            <ComboBox x:Name="StateFilter" DockPanel.Dock="Right" Width="96" Margin="6,0,0,0" SelectionChanged="OnFilter">
                                <ComboBoxItem Content="All states" IsSelected="True"/>
                                <ComboBoxItem Content="Enabled"/>
                                <ComboBoxItem Content="Disabled"/>
                            </ComboBox>
                            <ComboBox x:Name="ProviderFilter" SelectionChanged="OnFilter"/>
                        </DockPanel>
                    </StackPanel>
                    <ListBox x:Name="AliasList" ItemTemplate="{StaticResource AliasRow}" BorderThickness="0,1,0,0" Background="Transparent"
                             SelectionChanged="OnAliasSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="✉  New email from this address" Click="OnComposeFromAlias"/>
                                <MenuItem Header="⧉  Copy address" Click="OnCopyAlias"/>
                                <Separator/>
                                <MenuItem Header="✎  Edit note / site" Click="OnEditAlias"/>
                                <MenuItem Header="⏻  Enable / disable" Click="OnToggleAlias"/>
                                <MenuItem Header="📁  Create folder and route mail" Click="OnRouteAlias"/>
                                <Separator/>
                                <MenuItem Header="🗑  Delete masked address…" Click="OnDeleteAlias"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Middle: alias card + messages -->
            <DockPanel Grid.Column="2">
                <Border x:Name="AliasCard" DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="10,10,10,6" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" x:Name="CardState" CornerRadius="2" Padding="6,1" VerticalAlignment="Top">
                                <TextBlock x:Name="CardStateText" FontSize="{DynamicResource FsCaption}" FontWeight="Bold" Foreground="{DynamicResource Bg}"/>
                            </Border>
                            <TextBlock x:Name="CardTitle" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="⧉ copy" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="OnCopyAlias"/>
                            <TextBox x:Name="CardEmail" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FsInput}" Foreground="{DynamicResource Accent}"/>
                        </DockPanel>
                        <TextBlock x:Name="CardMeta" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                        <!-- Throwaway addresses: countdown and quick actions -->
                        <Border x:Name="ThrowawayBar" BorderBrush="{DynamicResource Warn}" BorderThickness="1" CornerRadius="2" Padding="8,5" Margin="0,0,0,8" Visibility="Collapsed">
                            <WrapPanel>
                                <TextBlock x:Name="ThrowawayText" Foreground="{DynamicResource Warn}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,2"/>
                                <Button Content="📥 Inbox" Style="{StaticResource SmallButton}" Click="OnThrowawayInbox" ToolTip="Live inbox: codes and links as mail arrives"/>
                                <Button x:Name="ThrowawayExtendBtn" Content="+1 hour" Style="{StaticResource SmallButton}" Click="OnThrowawayExtend"/>
                                <Button Content="Keep it" Style="{StaticResource SmallButton}" Click="OnThrowawayKeep" ToolTip="Make it a normal masked address that never expires"/>
                                <Button Content="🔥 Burn now" Style="{StaticResource SmallButton}" Foreground="{DynamicResource Bad}" Click="OnThrowawayBurn"/>
                            </WrapPanel>
                        </Border>
                        <WrapPanel>
                            <Button x:Name="CardCompose" Content="✉ Email" Style="{StaticResource SmallButton}" Click="OnComposeFromAlias" ToolTip="Write an email from this address"/>
                            <Button x:Name="CardToggle" Style="{StaticResource SmallButton}" Click="OnToggleAlias"/>
                            <Button x:Name="CardEdit" Content="✎ Edit" Style="{StaticResource SmallButton}" Click="OnEditAlias"/>
                            <Button x:Name="CardRoute" Style="{StaticResource SmallButton}" Click="OnRouteAlias"/>
                            <Button x:Name="CardActivity" Content="📊 Activity" Style="{StaticResource SmallButton}" Click="OnAliasActivity" ToolTip="Recent deliveries reported by the service"/>
                            <Button x:Name="CardDelete" Content="🗑 Delete" Style="{StaticResource SmallButton}" Foreground="{DynamicResource Bad}" Click="OnDeleteAlias"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="10,4,10,6">
                    <Button DockPanel.Dock="Right" x:Name="MoreBtn" Content="older ›" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="OnMore" Visibility="Collapsed"/>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="SourceNote" Style="{StaticResource Hint}" Margin="0,2,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                    <TextBlock x:Name="FolderTitle" Text="Inbox" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Grid>
                    <ListBox x:Name="MessageList" ItemTemplate="{StaticResource MessageRow}" BorderThickness="0,1,0,0" Background="Transparent"
                             SelectionChanged="OnMessageSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"/>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{DynamicResource Line}"/>

            <!-- Right: reader -->
            <DockPanel Grid.Column="4">
                <Border DockPanel.Dock="Top" x:Name="ReaderHead" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ReadSubject" Style="{StaticResource H1}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ReadFrom" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ReadTo" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                        <WrapPanel x:Name="ReadAttachments" Margin="0,6,0,0"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="ReplyBtn" Content="↩ Reply" Style="{StaticResource SmallButton}" Click="OnReply"/>
                            <Button x:Name="ReplyAllBtn" Content="↩↩ Reply all" Style="{StaticResource SmallButton}" Click="OnReplyAll"/>
                            <Button x:Name="ForwardBtn" Content="↪ Forward" Style="{StaticResource SmallButton}" Click="OnForward"/>
                            <Button x:Name="ImagesBtn" Content="🖼 Load images" Style="{StaticResource SmallButton}" Click="OnLoadImages" ToolTip="Remote images are blocked so senders cannot tell you opened the mail"/>
                            <Button x:Name="MarkUnreadBtn" Content="✉ Mark unread" Style="{StaticResource SmallButton}" Click="OnMarkUnread"/>
                            <Button x:Name="DeleteMsgBtn" Content="🗑 Delete" Style="{StaticResource SmallButton}" Foreground="{DynamicResource Bad}" Click="OnDeleteMessage" ToolTip="Move to Trash (Del)"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Grid>
                    <wv2:WebView2 x:Name="Reader" DefaultBackgroundColor="Transparent"/>
                    <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                        <Image Source="Assets/logo.png" Width="72" Height="72" Opacity="0.85" Margin="0,0,0,12"/>
                        <TextBlock x:Name="WelcomeText" Style="{StaticResource Hint}" TextAlignment="Center"/>
                        <Button x:Name="WelcomeBtn" Content="Open Settings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,14,0,0" Click="OnSettings"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
